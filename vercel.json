{
    "buildCommand": "npm run build",
    "installCommand": "npm install",
    "framework": "nextjs",
    "rewrites": [
        {
            "source": "/socket.io",
            "destination": "https://server-restourant.onrender.com/socket.io/"
        },
        {
            "source": "/api/:path*",
            "destination": "https://server-restourant.onrender.com/:path*"
        }
    ]
}